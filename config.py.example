# Configuration for Brewfather API
# Rename this file to config.py and fill in your credentials
# Get credentials from: https://web.brewfather.app/tabs/settings

# Brewing software API to use
BREWING_SOFTWARE = "brewfather"

BREWFATHER_USER_ID = "your_user_id_here"
BREWFATHER_API_KEY = "your_api_key_here"

# Optional Wi-Fi fallback credentials.
# Used only if UIFlow NVS keys (uiflow:ssid0/pswd0) are missing.
WIFI_SSID = ""
WIFI_PASSWORD = ""

# Language configuration
# Supported languages: 'en' (English), 'fr' (Francais)
LANGUAGE = "en"

# Grain weighing tolerance in grams
GRAIN_WEIGHT_TOLERANCE = 10

# Debug mode
DEBUG = False

# Launcher memory behavior
LAUNCHER_LOAD_IMAGES = False

# Maximum wait time for Wi-Fi connect before API calls fail fast.
API_WIFI_CONNECT_TIMEOUT_S = 8

# UI sound feedback toggles
ROTARY_BEEP_ENABLED = True
BUTTON_SHORT_BEEP_ENABLED = True
BUTTON_LONG_BEEP_ENABLED = True

# Setup web portal options (settings app)
SETUP_AP_SSID = "UHB-Scale-Setup"
SETUP_AP_PASSWORD = "brewsetup123"
SETUP_AUTO_STOP_MIN = 10
SETUP_REQUIRE_TOKEN = False
SETUP_TOKEN = ""
SETUP_REBOOT_AFTER_SAVE = False
