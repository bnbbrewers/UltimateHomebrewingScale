# Configuration for Ultimate Homebrewing Scale
# Rename this file to config.py and fill in your credentials
# Get credentials from: https://web.brewfather.app/tabs/settings

# Brewing software API to use
BREWING_SOFTWARE = "brewfather"

BREWFATHER_USER_ID = "your_user_id_here"
BREWFATHER_API_KEY = "your_api_key_here"


# Language configuration
# Supported languages: 'en' (English), 'fr' (Francais)
LANGUAGE = "en"

# Grain weighing tolerance in grams
GRAIN_WEIGHT_TOLERANCE = 20

# Hop weighing tolerance in grams
HOP_WEIGHT_TOLERANCE = 5

# Spunding valve inertia compensation for keg filling
KEG_SPUNDING_VALVE_INERTIA_ML = 200

# M5Dial Port B pins for the Unit Relay
KEG_RELAY_IO = (1, 2)

# Minutes without activity before the device enters deep sleep.
# 0 disables standby. Waking is done by touching the screen: the main button
# cannot wake the board, GPIO42 is not an RTC GPIO on the ESP32-S3.
# Waking is a full reboot, so the device returns to the launcher.
STANDBY_TIMEOUT_MIN = 0

# Optional runtime watchdog timeout in milliseconds (minimum: 5000).
# Leave this setting absent/commented to disable the watchdog.
# The setup portal manages this line through its "Battery powered" checkbox:
# on battery there is no way to recover but the watchdog, on mains you can
# simply cut the power.
# WATCHDOG_TIMEOUT_MS = 15000

# Debug mode
DEBUG = False

# Release channel used by the hidden updater app: "stable" or "prerelease"
UPDATE_CHANNEL = "stable"

# Hidden debug flag: try the updater on boot.
UPDATE_ON_BOOT = False
